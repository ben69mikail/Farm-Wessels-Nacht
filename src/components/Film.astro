---
/* Vollbild-Film: wächst beim Scrollen aus einem abgerundeten Fenster, spielt stumm, Ton auf Wunsch. */
import Icon from './Icon.astro';
interface Props { src: string; src720?: string; poster: string; title: string; sub: string; play: string; pause: string; sound: string; mute: string }
const { src, src720, poster, title, sub, play, pause, sound, mute } = Astro.props;
---
<section class="film">
  <div class="film__window" data-scrub-scale data-film>
    <video class="film__video" playsinline muted loop preload="metadata" poster={poster} aria-label={title}>
      {src720 && <source src={src720} type="video/mp4" media="(max-width: 899px)" />}
      <source src={src} type="video/mp4" />
    </video>
    <div class="film__shade" aria-hidden="true"></div>
    <div class="film__copy wrap">
      <h2 class="display t-3 lines"><span class="line"><span>{title}</span></span></h2>
      <p class="lead" data-reveal>{sub}</p>
    </div>
    <div class="film__ctl">
      <button type="button" data-film-play aria-label={pause} data-play={play} data-pause={pause}><Icon name="pause" class="i-pause" /><Icon name="play" class="i-play" /></button>
      <button type="button" data-film-mute aria-label={sound} aria-pressed="false" data-sound={sound} data-mute={mute}><Icon name="mute" class="i-mute" /><Icon name="sound" class="i-sound" /></button>
    </div>
  </div>
</section>
<script>
  const box = document.querySelector<HTMLElement>('[data-film]');
  const v = box?.querySelector('video');
  if (box && v) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const playBtn = box.querySelector<HTMLButtonElement>('[data-film-play]')!;
    const muteBtn = box.querySelector<HTMLButtonElement>('[data-film-mute]')!;
    const setPlaying = (on: boolean) => { box.classList.toggle('is-paused', !on); playBtn.setAttribute('aria-label', on ? playBtn.dataset.pause! : playBtn.dataset.play!); };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !reduce && !box.classList.contains('user-paused')) v.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
      else if (!e.isIntersecting) { v.pause(); }
    }, { threshold: 0.25 }).observe(box);
    if (reduce) setPlaying(false);
    playBtn.addEventListener('click', () => {
      if (v.paused) { box.classList.remove('user-paused'); v.play(); setPlaying(true); }
      else { box.classList.add('user-paused'); v.pause(); setPlaying(false); }
    });
    muteBtn.addEventListener('click', () => {
      v.muted = !v.muted; muteBtn.setAttribute('aria-pressed', String(!v.muted));
      muteBtn.setAttribute('aria-label', v.muted ? muteBtn.dataset.sound! : muteBtn.dataset.mute!);
      box.classList.toggle('has-sound', !v.muted);
    });
  }
</script>
<style>
  .film { padding-block: var(--section) 0; }
  .film__window { position: relative; height: min(100svh, 56.25vw + 20rem); min-height: 70svh; overflow: hidden; background: var(--night-deep); display: grid; align-items: end; transform-origin: center; will-change: transform; }
  .film__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .film__shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, oklch(0.095 0.01 60 / 0.85)); pointer-events: none; }
  .film__copy { position: relative; padding-bottom: clamp(2.5rem, 7vw, 5rem); display: grid; gap: 1rem; }
  .film__ctl { position: absolute; right: var(--gutter); top: clamp(1.25rem, 4vw, 2.5rem); display: flex; gap: 0.5rem; }
  .film__ctl button { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: oklch(0.1 0.01 60 / 0.55); backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.18); transition: background var(--t-fast); }
  .film__ctl button:hover { background: oklch(1 0 0 / 0.18); }
  .film__ctl :global(svg) { width: 1.25rem; height: 1.25rem; }
  :global(.i-play), :global(.i-sound) { display: none; }
  .is-paused :global(.i-play) { display: block; } .is-paused :global(.i-pause) { display: none; }
  .has-sound :global(.i-sound) { display: block; } .has-sound :global(.i-mute) { display: none; }
  @media (prefers-reduced-motion: reduce) { .film__window { transform: none !important; border-radius: var(--r-lg) !important; } }
</style>
