---
/* Ein Strichsatz (1.6 px), damit alle Symbole dieselbe Sprache sprechen. */
interface Props { name: 'arrow' | 'phone' | 'mail' | 'whatsapp' | 'menu' | 'close' | 'play' | 'pause' | 'pin' | 'eye' | 'eye-off' | 'chevron' | 'sound' | 'mute'; class?: string }
const { name, class: cls = '' } = Astro.props;
const paths: Record<string, string> = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  chevron: '<path d="M9 6l6 6-6 6"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/>',
  whatsapp: '<path d="M3 21l1.7-4.6A8.5 8.5 0 1 1 8 19.5Z"/><path d="M9.5 9.5c0 3 2 5 5 5l1-1.5-2-1-1 .8a4 4 0 0 1-1.6-1.6l.8-1-1-2Z"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  play: '<path d="M7 5v14l12-7Z"/>',
  pause: '<path d="M8 5v14M16 5v14"/>',
  pin: '<path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11Z"/><circle cx="12" cy="10" r="2.2"/>',
  eye: '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  'eye-off': '<path d="M3 3l18 18M10 10a3 3 0 0 0 4 4M6.5 6.7C4 8.3 2 12 2 12s3.5 6 10 6c1.6 0 3-.3 4.3-.9M9.9 6.2A10 10 0 0 1 12 6c6.5 0 10 6 10 6s-1 1.8-2.9 3.4"/>',
  sound: '<path d="M4 9v6h4l5 4V5L8 9Z"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/>',
  mute: '<path d="M4 9v6h4l5 4V5L8 9Z"/><path d="M16 9l5 6M21 9l-5 6"/>',
};
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
