---
/* Galerie: zwei große Bilder oben, vier kleinere darunter – alle im selben 3:2-Schnitt. Lightbox. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title?: string; items: readonly { src: ImageMetadata; alt: string }[]; open: string; close: string; prev: string; next: string }
const { title, items, open, close, prev, next } = Astro.props;
const id = `g${Math.random().toString(36).slice(2, 7)}`;
---
<section class="section gallery" data-gallery={id}>
  <div class="wrap">
    {title && <h2 class="display t-3 lines gallery__title"><span class="line"><span>{title}</span></span></h2>}
    <ul class="gallery__grid">
      {items.map((it, i) => (
        <li class:list={['gallery__item', { 'gallery__item--lead': i < 2 }]} data-reveal style={`--d:${(i % 4) * 80}ms`}>
          <button type="button" class="frame gallery__btn" data-gallery-open={i} aria-label={`${open}: ${it.alt}`} data-cursor={open}>
            <Image src={it.src} alt={it.alt} widths={[500, 900, 1400]} sizes={i < 2 ? '(min-width: 900px) 46vw, 92vw' : '(min-width: 900px) 23vw, 46vw'} loading="lazy" decoding="async" />
          </button>
        </li>
      ))}
    </ul>
  </div>
  <dialog class="lb" data-lightbox aria-label={title}>
    <button type="button" class="lb__close" data-lb-close aria-label={close}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <button type="button" class="lb__nav lb__nav--prev" data-lb-prev aria-label={prev}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
    <button type="button" class="lb__nav lb__nav--next" data-lb-next aria-label={next}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
    <figure class="lb__fig">
      <img data-lb-img alt="" />
      <figcaption data-lb-cap class="muted"></figcaption>
    </figure>
  </dialog>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const dlg = g.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    const btns = [...g.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')];
    const srcs = btns.map((b) => { const i = b.querySelector('img')!; return { src: i.currentSrc || i.src, srcset: i.srcset, alt: i.alt }; });
    let idx = 0;
    const show = (n: number) => {
      idx = (n + srcs.length) % srcs.length;
      img.classList.remove('is-in');
      const pic = btns[idx].querySelector('img')!;
      img.src = pic.currentSrc || pic.src; img.alt = srcs[idx].alt; cap.textContent = srcs[idx].alt;
      requestAnimationFrame(() => img.classList.add('is-in'));
    };
    // Nicht-modal öffnen: showModal() legt den Dialog in die Top-Layer-Ebene, über den eigenen Cursor.
    let opener: HTMLElement | null = null;
    const openAt = (i: number, from: HTMLElement) => { opener = from; show(i); dlg.show(); dlg.querySelector<HTMLElement>('[data-lb-close]')!.focus(); window.dispatchEvent(new Event('ww:lock')); };
    const close = () => { if (dlg.open) dlg.close(); };
    btns.forEach((b, i) => b.addEventListener('click', () => openAt(i, b)));
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('close', () => { window.dispatchEvent(new Event('ww:unlock')); opener?.focus(); });
    dlg.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === dlg || t.classList.contains('lb__fig')) close(); });
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(idx + 1);
      if (e.key === 'ArrowLeft') show(idx - 1);
    });
  });
</script>
<style>
  .gallery__title { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .gallery__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(0.75rem, 1.5vw, 1.25rem); }
  .gallery__item--lead { grid-column: 1 / -1; }
  .gallery__btn { display: block; width: 100%; aspect-ratio: 3 / 2; padding: 0; border-radius: var(--r-lg); }
  .gallery__btn :global(img) { transition: transform 1.2s var(--ease-out), filter 0.6s; }
  .gallery__btn:hover :global(img) { transform: scale(1.05); }
  @media (min-width: 900px) {
    .gallery__grid { grid-template-columns: repeat(4, 1fr); }
    .gallery__item--lead { grid-column: span 2; }
  }
  .lb { position: fixed; inset: 0; z-index: var(--z-lightbox); border: 0; padding: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; color: var(--ink); background: oklch(0.07 0.01 60 / 0.94); backdrop-filter: blur(10px); }
  .lb[open] { display: block; }
  .lb__fig { position: absolute; inset: 0; display: grid; place-items: center; gap: 1rem; padding: clamp(3.5rem, 8vh, 5rem) clamp(1rem, 6vw, 5rem); grid-template-rows: minmax(0, 1fr) auto; min-height: 0; }
  .lb__fig img { max-width: 100%; max-height: 100%; width: auto; height: auto; min-height: 0; object-fit: contain; border-radius: var(--r-md); opacity: 0; transform: scale(0.97); transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out); }
  .lb__fig img.is-in { opacity: 1; transform: none; }
  .lb__close, .lb__nav { position: absolute; z-index: 2; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: oklch(1 0 0 / 0.08); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.18); transition: background var(--t-fast); }
  .lb__close:hover, .lb__nav:hover { background: oklch(1 0 0 / 0.18); }
  .lb__close { top: 1rem; right: 1rem; }
  .lb__nav { top: 50%; translate: 0 -50%; } .lb__nav--prev { left: 1rem; } .lb__nav--next { right: 1rem; }
  .lb svg { width: 1.3rem; height: 1.3rem; }
</style>
