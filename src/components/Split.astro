---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; a: string; b?: string; flip?: boolean; arch?: boolean; ratio?: string; focus?: string }
const { image, alt, a, b, flip = false, arch = false, ratio = '4 / 5', focus = '50% 50%' } = Astro.props;
---
<section class="section split" class:list={{ 'split--flip': flip }}>
  <div class="wrap split__grid">
    <div class:list={['frame split__img', { 'frame--arch': arch }]} data-parallax="9" data-reveal="scale" style={`--ratio:${ratio}; --focus:${focus}`}>
      <Image src={image} alt={alt} widths={[600, 900, 1400]} sizes="(min-width: 900px) 46vw, 92vw" loading="lazy" decoding="async" />
    </div>
    <div class="split__text stack" style="--flow:1.4rem">
      <h2 class="display t-3 lines"><span class="line"><span>{a}</span></span>{b && <span class="line"><span><em>{b}</em></span></span>}</h2>
      <slot />
    </div>
  </div>
</section>
<style>
  .split__grid { display: grid; gap: 2.5rem; align-items: center; }
  .split__img { aspect-ratio: var(--ratio); }
  .split__img :global(img) { object-position: var(--focus); }
  .split__text :global(p) { max-width: var(--measure); }
  @media (min-width: 900px) {
    .split__grid { grid-template-columns: 1fr 1fr; gap: 6rem; }
    .split--flip .split__img { order: 2; }
  }
</style>
