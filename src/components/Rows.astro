---
/* Ruhige Liste: Titel links, Text rechts, Glut-Linie beim Hover. Optional ein Bild unter dem Titel. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title?: string; items: readonly { title: string; text: string }[]; image?: ImageMetadata; imageAlt?: string; caption?: string }
const { title, items, image, imageAlt = '', caption } = Astro.props;
---
<section class="section section--tight">
  <div class:list={["wrap rows", { "rows--solo": !title }]}>
    {title && <div class="rows__side">
      <h2 class="display t-3 rows__title lines"><span class="line"><span>{title}</span></span></h2>
      {image && <figure class="rows__fig" data-reveal="scale" style="--d:150ms">
        <div class="frame rows__img"><Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 28vw, 92vw" loading="lazy" decoding="async" /></div>
        {caption && <figcaption class="small muted">{caption}</figcaption>}
      </figure>}
    </div>}
    <ul class="rows__list">
      {items.map((f, i) => (
        <li data-reveal style={`--d:${i * 90}ms`}>
          <h3 class="display t-2">{f.title}</h3>
          <p class="muted">{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rows { display: grid; gap: 2rem; }
  .rows__side { display: grid; gap: 1.5rem; align-content: start; }
  .rows__fig { display: grid; gap: 0.6rem; max-width: 24rem; }
  .rows__img { aspect-ratio: 1080 / 630; border-radius: var(--r-md); box-shadow: 0 30px 60px -35px oklch(0 0 0 / 0.9); }
  .rows__img :global(img) { transition: transform 1.2s var(--ease-out); }
  .rows__fig:hover .rows__img :global(img) { transform: scale(1.04); }
  .rows__fig figcaption { padding-left: 0.25rem; }
  @media (min-width: 900px) { .rows__side { position: sticky; top: 7rem; } }
  .rows__list { display: grid; }
  .rows__list li { display: grid; gap: 0.6rem; padding: clamp(1.5rem, 3vw, 2.25rem) 0; border-top: 1px solid var(--line); position: relative; }
  .rows__list li:last-child { border-bottom: 1px solid var(--line); }
  .rows__list li::before { content: ''; position: absolute; top: -1px; left: 0; height: 1px; width: 0; background: var(--ember); transition: width 1.2s var(--ease-out); }
  .rows__list li:hover::before { width: 100%; }
  .rows__list li p { max-width: var(--measure); }
  @media (min-width: 900px) { .rows--solo { grid-template-columns: 1fr; } .rows { grid-template-columns: 1fr 2fr; gap: 4rem; align-items: start; } .rows__list li { grid-template-columns: 1fr 1.3fr; gap: 2rem; } }
</style>
