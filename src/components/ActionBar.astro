---
import { href, type Locale } from '../content/nav';
import { t } from '../content';
import { telHref, waHref, mailHref } from '../content/contact';
import Icon from './Icon.astro';
interface Props { locale: Locale; pageKey: string }
const { locale, pageKey } = Astro.props;
const copy = t(locale);
---
<nav class="bar" aria-label={locale === 'de' ? 'Schnellkontakt' : 'Quick contact'}>
  {waHref && <a href={waHref} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>{copy.ui.whatsapp}</span></a>}
  {telHref && <a href={telHref}><Icon name="phone" /><span>{copy.ui.call}</span></a>}
  <a href={mailHref}><Icon name="mail" /><span>{copy.ui.mail}</span></a>
  {pageKey !== 'contact' && <a href={href('contact', locale)} class="bar__cta"><Icon name="arrow" /><span>{copy.ui.enquireShort}</span></a>}
</nav>
<style>
  .bar {
    position: fixed; left: 0.75rem; right: 0.75rem; bottom: calc(0.75rem + env(safe-area-inset-bottom)); z-index: var(--z-bar);
    display: flex; gap: 0.25rem; padding: 0.35rem; border-radius: var(--r-pill);
    background: oklch(0.12 0.012 60 / 0.8); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.1), 0 20px 40px -20px oklch(0 0 0 / 0.9);
  }
  .bar a { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem; min-height: 56px; border-radius: var(--r-pill); font-size: 0.72rem; font-weight: 500; color: var(--ink-soft); }
  .bar a :global(svg) { width: 1.3rem; height: 1.3rem; }
  .bar__cta { background: var(--ember); color: #fff !important; }
  @media (min-width: 900px) { .bar { display: none; } }
  body.menu-open .bar { visibility: hidden; }
</style>
