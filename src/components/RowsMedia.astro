---
/* Liste mit kleinem Bild je Zeile: Bild schält sich beim Scrollen aus dem Bogen, wächst beim Hover
   und folgt auf dem Desktop als große Vorschau dem Cursor. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title?: string; items: readonly { title: string; text: string }[]; images: ImageMetadata[]; alts?: string[] }
const { title, items, images, alts = [] } = Astro.props;
---
<section class="section section--tight">
  <div class:list={['wrap rm', { 'rm--solo': !title }]} data-rm>
    {title && <h2 class="display t-3 lines"><span class="line"><span>{title}</span></span></h2>}
    <ul class="rm__list">
      {items.map((f, i) => (
        <li class="rm__row" data-reveal data-rm-row={i} style={`--d:${i * 110}ms`}>
          <div class="frame rm__thumb"><Image src={images[i]} alt={alts[i] ?? ''} width="720" height="480" loading="lazy" decoding="async" /></div>
          <h3 class="display t-2">{f.title}</h3>
          <p class="muted">{f.text}</p>
        </li>
      ))}
    </ul>
    <div class="rm__float" aria-hidden="true" data-rm-float>
      {images.map((img, i) => <div class="rm__float-img" data-rm-float-img={i}><Image src={img} alt="" width="960" height="640" loading="lazy" decoding="async" /></div>)}
    </div>
  </div>
</section>
<script>
  import gsap from 'gsap';
  document.querySelectorAll<HTMLElement>('[data-rm]').forEach((wrap) => {
    if (!window.matchMedia('(pointer: fine) and (min-width: 900px)').matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const float = wrap.querySelector<HTMLElement>('[data-rm-float]')!;
    const imgs = float.querySelectorAll<HTMLElement>('[data-rm-float-img]');
    const xTo = gsap.quickTo(float, 'x', { duration: 0.7, ease: 'power3.out' });
    const yTo = gsap.quickTo(float, 'y', { duration: 0.7, ease: 'power3.out' });
    const rTo = gsap.quickTo(float, 'rotation', { duration: 0.9, ease: 'power3.out' });
    let lastX = 0;
    wrap.querySelectorAll<HTMLElement>('[data-rm-row]').forEach((row) => {
      row.addEventListener('mouseenter', () => { imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.rmFloatImg === row.dataset.rmRow)); float.classList.add('is-on'); });
      row.addEventListener('mouseleave', () => float.classList.remove('is-on'));
      row.addEventListener('mousemove', (e) => {
        const r = wrap.getBoundingClientRect();
        xTo(e.clientX - r.left + 28); yTo(e.clientY - r.top - 140);
        rTo(Math.max(-8, Math.min(8, (e.clientX - lastX) * 0.4))); lastX = e.clientX;
      });
    });
  });
</script>
<style>
  .rm { position: relative; display: grid; gap: 2rem; }
  .rm__list { display: grid; }
  .rm__row { display: grid; grid-template-columns: 5.5rem 1fr; grid-template-rows: auto auto; gap: 0.4rem 1.25rem; padding: clamp(1.5rem, 3vw, 2.25rem) 0; border-top: 1px solid var(--line); position: relative; align-items: start; }
  .rm__row:last-child { border-bottom: 1px solid var(--line); }
  .rm__row::before { content: ''; position: absolute; top: -1px; left: 0; height: 1px; width: 0; background: var(--ember); transition: width 1.2s var(--ease-out); }
  .rm__row:hover::before { width: 100%; }
  .rm__thumb { grid-row: 1 / 3; width: 6.5rem; aspect-ratio: 3 / 2; border-radius: var(--r-sm); clip-path: inset(0 100% 0 0 round 14px); transition: clip-path 1.1s var(--ease-out), transform 0.8s var(--ease-out); transform-origin: bottom center; }
  .rm__thumb :global(img) { object-fit: cover; }
  .rm__thumb :global(img) { transition: transform 1s var(--ease-out); }
  .rm__row.is-in .rm__thumb { clip-path: inset(0 0 0 0 round 14px); }
  .rm__row:hover .rm__thumb { transform: translateY(-4px) rotate(-2deg) scale(1.06); }
  .rm__row:hover .rm__thumb :global(img) { transform: scale(1.12); }
  .rm__row p { max-width: var(--measure); }
  .rm__float { position: absolute; left: 0; top: 0; width: 22rem; aspect-ratio: 3 / 2; pointer-events: none; z-index: 3; opacity: 0; scale: 0.85; transition: opacity 0.45s var(--ease-out), scale 0.6s var(--ease-out); border-radius: var(--r-md); overflow: hidden; box-shadow: 0 40px 80px -30px oklch(0 0 0 / 0.9); display: none; }
  .rm__float.is-on { opacity: 1; scale: 1; }
  .rm__float-img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.4s; }
  .rm__float-img.is-on { opacity: 1; }
  .rm__float-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 900px) {
    .rm { grid-template-columns: 1fr 2fr; gap: 4rem; align-items: start; }
    .rm--solo { grid-template-columns: 1fr; }
    .rm__row { grid-template-columns: 9rem 1fr 1.3fr; grid-template-rows: auto; gap: 2rem; }
    .rm__thumb { grid-row: auto; width: 9rem; }
    .rm__float { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .rm__thumb { clip-path: none !important; transition: none; } .rm__row:hover .rm__thumb { transform: none; } }
</style>
