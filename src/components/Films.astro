---
/* Filmstreifen: ein Leitfilm groß, zwei kleiner daneben. Preload aus, Klick startet mit Ton
   und schaltet die Systemsteuerung frei. Es läuft immer nur ein Film. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Film { title: string; meta: string; text: string; src: string; poster: ImageMetadata; alt: string }
interface Props { title: string; sub: string; note: string; play: string; items: readonly Film[] }
const { title, sub, note, play, items } = Astro.props;
const posters = await Promise.all(
  items.map((f, i) => getImage({ src: f.poster, width: i === 0 ? 1600 : 900, format: 'webp', quality: 74 })),
);
const [lead, ...rest] = items;
---
<section class="section films" data-films>
  <div class="wrap">
    <div class="films__head">
      <h2 class="display t-3 lines"><span class="line"><span>{title}</span></span></h2>
      <p class="muted measure" data-reveal>{sub}</p>
    </div>

    <figure class="film2 film2--lead" data-reveal>
      <div class="frame film2__frame" data-cursor={play}>
        <video preload="none" playsinline poster={posters[0].src} src={lead.src} aria-label={lead.alt} data-film2></video>
        <button type="button" class="film2__play" data-film2-play aria-label={`${play}: ${lead.title}`}>
          <span class="film2__disc" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.2 19 12 8 18.8z"/></svg></span>
        </button>
      </div>
      <figcaption class="film2__cap">
        <div>
          <h3 class="display t-2">{lead.title}</h3>
          <p class="film2__meta">{lead.meta}</p>
        </div>
        <p class="muted">{lead.text}</p>
      </figcaption>
    </figure>

    <div class="films__rest">
      {rest.map((f, i) => (
        <figure class="film2" data-reveal style={`--d:${(i + 1) * 90}ms`}>
          <div class="frame film2__frame" data-cursor={play}>
            <video preload="none" playsinline poster={posters[i + 1].src} src={f.src} aria-label={f.alt} data-film2></video>
            <button type="button" class="film2__play" data-film2-play aria-label={`${play}: ${f.title}`}>
              <span class="film2__disc film2__disc--sm" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.2 19 12 8 18.8z"/></svg></span>
            </button>
          </div>
          <figcaption class="film2__cap">
            <div>
              <h3 class="display t-1">{f.title}</h3>
              <p class="film2__meta">{f.meta}</p>
            </div>
            <p class="muted small">{f.text}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="films__note">{note}</p>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-films]').forEach((sec) => {
    const vids = [...sec.querySelectorAll<HTMLVideoElement>('[data-film2]')];
    vids.forEach((v) => {
      const frame = v.closest<HTMLElement>('.film2__frame')!;
      const btn = frame.querySelector<HTMLButtonElement>('[data-film2-play]')!;
      const start = () => {
        vids.filter((o) => o !== v).forEach((o) => o.pause());
        v.controls = true;
        v.muted = false;
        v.play().catch(() => { v.muted = true; v.play().catch(() => {}); });
        frame.classList.add('is-playing');
      };
      btn.addEventListener('click', start);
      const reset = () => { v.controls = false; frame.classList.remove('is-playing'); };
      v.addEventListener('pause', () => { if (v.currentTime === 0) reset(); });
      v.addEventListener('ended', () => { v.currentTime = 0; reset(); });
      v.addEventListener('error', reset);
    });
  });
</script>
<style>
  .films__head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .film2 { margin: 0; display: grid; gap: 1.25rem; }
  .film2__frame { aspect-ratio: 16 / 9; border-radius: var(--r-lg); }
  .film2__frame video { width: 100%; height: 100%; object-fit: cover; display: block; background: var(--night-deep); }
  .film2__play { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; }
  .film2__play::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, oklch(0.1 0.01 60 / 0.55), oklch(0.1 0.01 60 / 0.05) 60%);
    transition: opacity 0.6s var(--ease-out);
  }
  .film2__disc {
    position: relative; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%;
    color: var(--gold); background: oklch(0.1 0.01 60 / 0.5); backdrop-filter: blur(8px);
    box-shadow: inset 0 0 0 1px var(--gold-soft);
    transition: transform 0.7s var(--ease-out), background 0.4s var(--ease-out), color 0.4s var(--ease-out);
  }
  .film2__disc--sm { width: 64px; height: 64px; }
  @media (max-width: 600px) { .film2__disc { width: 66px; height: 66px; } .film2__disc--sm { width: 58px; height: 58px; } }
  .film2__disc svg { width: 1.4rem; height: 1.4rem; margin-left: 4px; }
  .film2__disc--sm svg { width: 1.1rem; height: 1.1rem; }
  .film2__play:hover .film2__disc, .film2__play:focus-visible .film2__disc { transform: scale(1.08); background: var(--gold); color: var(--night-deep); }
  .film2__play:focus-visible { outline: none; }
  .film2__frame.is-playing .film2__play { display: none; }
  .film2__cap { display: grid; gap: 0.5rem; padding-inline: 0.35rem; }
  .film2__meta { color: var(--gold); font-size: 0.9rem; }
  .films__rest { display: grid; gap: clamp(1.75rem, 3vw, 2.5rem); margin-top: clamp(2rem, 4vw, 3.5rem); }
  .films__note { margin-top: clamp(2rem, 4vw, 3rem); padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.9rem; }
  @media (min-width: 900px) {
    .film2--lead .film2__cap { grid-template-columns: minmax(16rem, 1fr) 1.4fr; align-items: start; gap: 0.5rem 3rem; }
    .films__rest { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .film2__disc, .film2__play::before { transition: none; }
  }
</style>
