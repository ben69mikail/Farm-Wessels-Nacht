---
/* Kurzer Vorhang beim ersten Laden der Startseite: Wortmarke leuchtet auf, Vorhang hebt sich. Max. 1,4 s, danach nie wieder in dieser Sitzung. */
---
<div class="intro" data-intro aria-hidden="true">
  <div class="intro__word display">Wild Wessels<span>Safaris · Waterberg</span></div>
  <div class="intro__line"><i></i></div>
</div>
<script>
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el) {
    const seen = sessionStorage.getItem('ww-intro');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (seen || reduce) el.remove();
    else {
      document.body.classList.add('intro-on');
      el.classList.add('is-run');
      setTimeout(() => { el.classList.add('is-done'); document.body.classList.remove('intro-on'); }, 1500);
      setTimeout(() => el.remove(), 2600);
      try { sessionStorage.setItem('ww-intro', '1'); } catch {}
    }
  }
</script>
<style>
  .intro { position: fixed; inset: 0; z-index: var(--z-loader); background: var(--night-deep); display: grid; place-items: center; transition: clip-path 1.1s var(--ease-out); clip-path: inset(0 0 0 0); }
  .intro.is-done { clip-path: inset(0 0 100% 0); }
  .intro__word { font-size: clamp(1.8rem, 5vw, 3.4rem); text-align: center; display: grid; gap: 0.6rem; opacity: 0; transform: translateY(12px); transition: opacity 0.9s var(--ease-out) 0.1s, transform 1s var(--ease-out) 0.1s; }
  .intro__word span { font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); }
  .intro.is-run .intro__word { opacity: 1; transform: none; }
  .intro.is-done .intro__word { opacity: 0; transition: opacity 0.4s; }
  .intro__line { position: absolute; bottom: 18vh; width: min(40vw, 240px); height: 1px; background: var(--line); overflow: hidden; }
  .intro__line i { display: block; height: 100%; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease-out) 0.2s; }
  .intro.is-run .intro__line i { transform: scaleX(1); }
  body.intro-on { overflow: hidden; }
</style>
