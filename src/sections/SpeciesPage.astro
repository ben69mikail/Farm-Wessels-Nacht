---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Rows from '../components/Rows.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { t } from '../content';
import { v2 } from '../content/v2';
import { href, type Locale } from '../content/nav';
import hero from '../assets/hero/giraffe.jpg';
import imgGiraffe from '../assets/hero/giraffe.jpg';
import imgZebra from '../assets/hero/zebras.jpg';
import imgBuffalo from '../assets/hero/bushveld-see.jpg';
import imgNyala from '../assets/lodge/felsen.jpg';
import imgHartebeest from '../assets/hero/ebene.jpg';
import imgWarthog from '../assets/lodge/damm.jpg';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale); const p = c.species; const x = v2[locale]; const de = locale === 'de';
const rows = p.confirmed.rows as readonly { de?: string; en?: string; latin: string; group: string; price?: string }[];
const imgs = [imgBuffalo, imgNyala, imgGiraffe, imgHartebeest, imgWarthog, imgZebra];
const notes = [x.speciesNote.buffalo, x.speciesNote.nyala, x.speciesNote.giraffe, x.speciesNote.hartebeest, x.speciesNote.warthog, x.speciesNote.zebra];
---
<Base locale={locale} pageKey="species" title={p.title} description={p.description}>
  <PageHero image={hero} alt={de ? 'Giraffe zwischen Akazien' : 'Giraffe between acacias'} kicker={p.hero.eyebrow} a={p.hero.h1a} b={p.hero.h1b} lead={p.hero.lead} focus="55% 40%" />

  <section class="section species species--tightbottom">
    <div class="wrap">
      <h2 class="display t-3 lines species__title"><span class="line"><span>{p.confirmed.h2}</span></span></h2>
      <ul class="species__list">
        {rows.map((r, i) => (
          <li class="sp" data-reveal style={`--d:${(i % 2) * 100}ms`}>
            <div class="frame frame--arch sp__img"><Image src={imgs[i]} alt="" width="800" height="1000" loading="lazy" decoding="async" /></div>
            <div class="sp__body">
              <h3 class="display t-2">{de ? r.de : r.en}</h3>
              <p class="sp__latin"><i>{r.latin}</i></p>
              <p class="muted">{notes[i]}</p>
              <dl class="sp__meta">
                <div><dt>{p.confirmed.table.group}</dt><dd>{r.group}</dd></div>
                <div><dt>{p.confirmed.table.price}</dt><dd>{r.price ?? c.ui.onRequest}</dd></div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
      <p class="species__note muted" data-reveal>{p.confirmed.note}</p>
    </div>
  </section>

  <!-- Vollständige Preisliste -->
  <section class="section plist">
    <div class="wrap">
      <div class="plist__head">
        <h2 class="display t-3 lines"><span class="line"><span>{p.list.h2}</span></span></h2>
        <p class="lead" data-reveal>{p.list.lead}</p>
      </div>
      <div class="plist__groups">
        {p.list.groups.map((g, gi) => (
          <section class="plist__group" data-reveal style={`--d:${gi * 120}ms`}>
            <h3 class="display t-2 plist__gtitle">{g.title}</h3>
            <ul class="plist__rows">
              {g.rows.map((r) => <li><span>{r.name}</span><i aria-hidden="true"></i><b>{r.price}</b></li>)}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- Tagespreise -->
  <section class="section rates">
    <div class="wrap rates__grid">
      <div class="stack" style="--flow:1.25rem">
        <h2 class="display t-3 lines"><span class="line"><span>{p.rates.h2a}</span></span><span class="line"><span><em>{p.rates.h2b}</em></span></span></h2>
        <p class="lead" data-reveal>{p.rates.lead}</p>
        <ul class="rates__list" data-reveal>
          {p.rates.items.map((it) => <li><span>{it.label}</span><b>{it.value}</b></li>)}
        </ul>
      </div>
      <div class="rates__ex" data-reveal style="--d:150ms">
        <h3 class="t-1 rates__exh">{p.rates.examples.h3}</h3>
        <p class="small muted">{p.rates.examples.note}</p>
        {p.rates.examples.items.map((ex) => (
          <article class="rates__card">
            <h4 class="display t-2">{ex.title}</h4>
            <ul>{ex.lines.map((l) => <li class="muted">{l}</li>)}</ul>
            <p class="rates__total"><span>{locale === 'de' ? 'Gesamt' : 'Total'}</span><b class="display">{ex.total}</b></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Pakete -->
  <section class="section packs">
    <div class="wrap">
      <div class="packs__head">
        <h2 class="display t-3 lines"><span class="line"><span>{p.packages.h2a}</span></span><span class="line"><span><em>{p.packages.h2b}</em></span></span></h2>
        <p class="lead" data-reveal>{p.packages.lead}</p>
      </div>
      <ul class="packs__grid">
        {p.packages.items.map((pk, i) => (
          <li class="pack" data-reveal style={`--d:${i * 120}ms`}>
            <h3 class="display t-2">{pk.title}</h3>
            <ul class="pack__species">{pk.species.map((sp) => <li>{sp}</li>)}</ul>
            <p class="pack__price display">{pk.price}</p>
            <a class="btn btn--ghost" href={href('contact', locale)}>{p.packages.cta}<Icon name="arrow" class="arrow" /></a>
          </li>
        ))}
      </ul>
      <p class="packs__incl muted" data-reveal>{p.packages.incl}</p>
    </div>
  </section>

  <section class="section pricing-intro"><div class="wrap stack pricing-intro__inner" style="--flow:1.25rem">
    <h2 class="display t-3 lines"><span class="line"><span>{p.pricing.h2a}</span></span><span class="line"><span><em>{p.pricing.h2b}</em></span></span></h2>
    <p class="lead" data-reveal>{p.pricing.lead}</p>
  </div></section>
  <section class="section section--tight"><div class="wrap blocks">
    {p.pricing.blocks.map((b, i) => (
      <article class="block" data-reveal style={`--d:${i * 120}ms`}>
        <h3 class="display t-2">{b.title}</h3>
        <p class="muted">{b.text}</p>
      </article>
    ))}
  </div></section>
  <section class="section section--tight"><div class="wrap incl">
    <div class="incl__col" data-reveal><h3 class="t-1 incl__h">{p.pricing.included.title}</h3><ul>{p.pricing.included.items.map((i) => <li><Icon name="arrow" />{i}</li>)}</ul></div>
    <div class="incl__col incl__col--ex" data-reveal style="--d:120ms"><h3 class="t-1 incl__h">{p.pricing.excluded.title}</h3><ul>{p.pricing.excluded.items.map((i) => <li><Icon name="close" />{i}</li>)}</ul></div>
  </div></section>
  <CtaBand a={p.cta.h2a} b={p.cta.h2b} text={p.cta.text} button={p.cta.button} href={href('contact', locale)} mailLabel={x.cta.mail} />
</Base>
<style>
  /* ---- Preisliste ---- */
  .plist__head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .plist__groups { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .plist__gtitle { color: var(--gold); margin-bottom: 1rem; }
  .plist__rows { display: grid; }
  .plist__rows li { display: flex; align-items: baseline; gap: 0.75rem; padding: 0.75rem 0; border-top: 1px solid var(--line); }
  .plist__rows li:last-child { border-bottom: 1px solid var(--line); }
  .plist__rows li i { flex: 1; border-bottom: 1px dotted var(--line-strong); translate: 0 -0.3em; }
  .plist__rows li b { font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* Zweier-Grid: links Großwild und darunter Raubwild & Kleinwild, rechts Antilopen & Plains Game über beide Zeilen */
  @media (min-width: 900px) {
    .plist__groups { grid-template-columns: 1fr 1fr; grid-template-rows: auto 1fr; column-gap: clamp(2.5rem, 5vw, 4.5rem); align-items: start; }
    .plist__group:nth-child(1) { grid-column: 1; grid-row: 1; }
    .plist__group:nth-child(2) { grid-column: 2; grid-row: 1 / span 2; }
    .plist__group:nth-child(3) { grid-column: 1; grid-row: 2; }
  }

  /* ---- Tagespreise ---- */
  .rates__grid { display: grid; gap: 3rem; }
  .rates__list { display: grid; }
  .rates__list li { display: flex; justify-content: space-between; align-items: baseline; gap: 1.5rem; padding: 0.9rem 0; border-top: 1px solid var(--line); }
  .rates__list li:last-child { border-bottom: 1px solid var(--line); }
  .rates__list b { font-weight: 500; white-space: nowrap; color: var(--gold); font-size: 1.15em; }
  .rates__ex { display: grid; gap: 1rem; align-content: start; }
  .rates__exh { font-weight: 500; }
  .rates__card { padding: clamp(1.25rem, 2.5vw, 2rem); border-radius: var(--r-lg); background: var(--surface); display: grid; gap: 0.75rem; }
  .rates__card ul { display: grid; gap: 0.25rem; }
  .rates__total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 0.75rem; border-top: 1px solid var(--line-strong); }
  .rates__total b { font-size: var(--fs-2); color: var(--gold); font-weight: 500; }
  @media (min-width: 900px) { .rates__grid { grid-template-columns: 1.2fr 1fr; gap: 5rem; align-items: start; } }

  /* ---- Pakete ---- */
  .packs__head { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .packs__grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .pack { display: grid; gap: 1rem; padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--r-lg); background: var(--surface); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.06); align-content: start; transition: transform 0.6s var(--ease-out), box-shadow 0.6s; }
  .pack:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px var(--gold-soft), 0 30px 60px -40px oklch(0 0 0 / 0.9); }
  .pack__species { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pack__species li { padding: 0.3rem 0.75rem; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px var(--line-strong); font-size: 0.9rem; }
  .pack__price { font-size: clamp(2.2rem, 4vw, 3.2rem); color: var(--gold); line-height: 1; margin-top: 0.5rem; }
  .pack .btn { justify-self: start; }
  .packs__incl { margin-top: 1.5rem; max-width: var(--measure); }

  .species__title { margin-bottom: clamp(2rem, 5vw, 4rem); }
  .species__list { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .sp { display: grid; gap: 1.25rem; align-items: center; }
  .sp__img { aspect-ratio: 4 / 5; }
  .sp__body { display: grid; gap: 0.5rem; align-content: center; }
  .sp__latin { color: var(--gold); }
  .sp__body p { max-width: 42ch; }
  .sp__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0.75rem 0 0; }
  .sp__meta div { display: grid; gap: 0.15rem; }
  .sp__meta dt { font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .sp__meta dd { margin: 0; font-weight: 500; }
  .species__note { margin: clamp(2rem, 5vw, 3.5rem) auto 0; max-width: var(--measure); padding: 1.25rem 1.5rem; border-radius: var(--r-md); background: var(--surface); text-align: center; }
  .species--tightbottom { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .pricing-intro { padding-top: clamp(2rem, 4vw, 3rem); padding-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .pricing-intro__inner { text-align: center; }
  .pricing-intro__inner .lead { margin-inline: auto; }
  @media (min-width: 700px) { .species__list { grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem); } .sp { grid-template-columns: 0.8fr 1.2fr; gap: 1.5rem; } .sp:nth-child(even) { transform: translateY(3rem); } }
  .blocks { display: grid; gap: 1.5rem; }
  .block { display: grid; gap: 1rem; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: var(--r-lg); background: var(--surface); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.06); position: relative; overflow: hidden; }
  .block::before { content: ''; position: absolute; top: 0; left: 0; height: 2px; width: 0; background: var(--ember); transition: width 1.2s var(--ease-out); }
  .block:hover::before { width: 100%; }
  .block h3 { color: var(--gold); }
  @media (min-width: 640px) { .block { grid-template-columns: 1fr 1.6fr; gap: 2rem; align-items: start; } }
  @media (min-width: 1000px) { .blocks { grid-template-columns: 1fr 1fr; } .block { grid-template-columns: 1fr; } }
  @media (min-width: 1300px) { .block { grid-template-columns: 0.8fr 1.4fr; } }
  .incl { display: grid; gap: 1.5rem; }
  .incl__col { padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: var(--r-lg); background: var(--surface); }
  .incl__h { margin-bottom: 1rem; color: var(--gold); font-weight: 500; }
  .incl ul { display: grid; gap: 0.6rem; }
  .incl li { display: flex; gap: 0.75rem; align-items: baseline; }
  .incl li :global(svg) { width: 1em; height: 1em; flex: none; translate: 0 0.15em; color: var(--gold); }
  .incl__col--ex li :global(svg) { color: var(--muted); }
  .incl__col--ex { background: transparent; box-shadow: inset 0 0 0 1px var(--line); }
  @media (min-width: 800px) { .incl { grid-template-columns: 1fr 1fr; } }
</style>
