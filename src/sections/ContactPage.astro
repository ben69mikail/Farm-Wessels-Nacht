---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { t } from '../content';
import { type Locale } from '../content/nav';
import { CONTACT, telHref, waHref, mailHref } from '../content/contact';
import hero from '../assets/hero/zebras.jpg';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = t(locale); const p = c.contact; const de = locale === 'de';
const formName = de ? 'anfrage-de' : 'enquiry-en';
const successUrl = de ? '/danke' : '/en/thank-you';
---
<Base locale={locale} pageKey="contact" title={p.title} description={p.description}>
  <PageHero image={hero} alt={de ? 'Zebraherde im Bushveld' : 'Herd of zebra in the bushveld'} kicker={p.hero.eyebrow} a={p.hero.h1a} b={p.hero.h1b} lead={p.hero.lead} focus="68% 50%" />
  <section class="section section--tight">
    <div class="wrap cgrid">
      <form class="form" name={formName} method="POST" action={successUrl} data-netlify="true" netlify-honeypot="bot-field" data-reveal>
        <input type="hidden" name="form-name" value={formName} />
        <p class="hp"><label>Do not fill this out: <input name="bot-field" /></label></p>
        <h2 class="display t-2">{p.form.h2}</h2>
        <div class="form__row">
          <label class="field"><input type="text" name="name" required autocomplete="name" placeholder=" " /><span>{p.form.name} *</span></label>
          <label class="field"><input type="email" name="email" required autocomplete="email" placeholder=" " /><span>{p.form.email} *</span></label>
        </div>
        <div class="form__row">
          <label class="field"><input type="tel" name="telefon" autocomplete="tel" placeholder=" " /><span>{p.form.phone}</span></label>
          <label class="field"><input type="text" name="zeitraum" placeholder=" " /><span>{p.form.period}</span></label>
        </div>
        <div class="form__row">
          <label class="field"><input type="number" name="jaeger" min="0" max="20" inputmode="numeric" placeholder=" " /><span>{p.form.hunters}</span></label>
          <label class="field"><input type="number" name="begleitpersonen" min="0" max="20" inputmode="numeric" placeholder=" " /><span>{p.form.companions}</span></label>
        </div>
        <label class="field"><input type="text" name="wildarten" placeholder=" " /><span>{p.form.species}</span></label>
        <label class="field field--area"><textarea name="nachricht" rows="6" placeholder=" "></textarea><span>{p.form.message}</span></label>
        <label class="consent"><input type="checkbox" name="einwilligung" required /><span class="small muted">{p.form.consent}</span></label>
        <button class="btn" type="submit" data-magnetic>{p.form.submit}<Icon name="arrow" class="arrow" /></button>
        <p class="small muted">* {p.form.required}</p>
      </form>
      <aside class="direct" data-reveal style="--d:150ms">
        <h2 class="display t-2">{p.direct.h2}</h2>
        <p class="muted">{p.direct.text}</p>
        <ul class="direct__list">
          <li><a class="direct__item" href={mailHref}><Icon name="mail" /><span>{CONTACT.email}</span></a></li>
          {telHref && <li><a class="direct__item" href={telHref}><Icon name="phone" /><span>{CONTACT.phone}</span></a></li>}
          {waHref && <li><a class="direct__item" href={waHref} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>WhatsApp</span></a></li>}
          <li><a class="direct__item" href={CONTACT.maps} target="_blank" rel="noopener"><Icon name="pin" /><span>{CONTACT.address}<br />{CONTACT.country[locale]}</span></a></li>
        </ul>
      </aside>
    </div>
  </section>
</Base>
<style>
  .cgrid { display: grid; gap: 3rem; }
  .hp { position: absolute; left: -9999px; }
  .form { display: grid; gap: 1.1rem; padding: clamp(1.5rem, 3.5vw, 3rem); border-radius: var(--r-lg); background: var(--surface); }
  .form h2 { margin-bottom: 0.5rem; }
  .form__row { display: grid; gap: 1.1rem; }
  @media (min-width: 640px) { .form__row { grid-template-columns: 1fr 1fr; } }
  .field { position: relative; display: block; }
  .field input, .field textarea { width: 100%; min-height: 3.6rem; padding: 1.45rem 1.25rem 0.6rem; border: 0; border-radius: var(--r-sm); background: var(--surface-2); color: var(--ink); font: inherit; box-shadow: inset 0 0 0 1px transparent; transition: box-shadow var(--t-med), background var(--t-fast); }
  .field textarea { resize: vertical; padding-top: 1.7rem; }
  .field span { position: absolute; left: 1.25rem; top: 1.1rem; color: var(--muted); pointer-events: none; transition: transform 0.3s var(--ease-out), font-size 0.3s, color 0.3s; transform-origin: left top; }
  .field input:focus, .field textarea:focus { outline: none; box-shadow: inset 0 0 0 1px var(--gold), 0 0 0 5px oklch(0.88 0.1 88 / 0.12); background: oklch(0.26 0.016 56); }
  .field input:focus ~ span, .field input:not(:placeholder-shown) ~ span, .field textarea:focus ~ span, .field textarea:not(:placeholder-shown) ~ span { transform: translateY(-0.7rem); font-size: 0.74rem; color: var(--gold); }
  .consent { display: flex; gap: 0.8rem; align-items: flex-start; margin-top: 0.5rem; }
  .consent input { width: 1.25rem; height: 1.25rem; margin: 0.15rem 0 0; accent-color: var(--ember); flex: none; }
  .form .btn { justify-self: start; margin-top: 0.5rem; }
  .direct { display: grid; gap: 1rem; align-content: start; }
  .direct__list { display: grid; gap: 0.5rem; margin-top: 0.5rem; }
  .direct__item { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.25rem; border-radius: var(--r-md); box-shadow: inset 0 0 0 1px var(--line); transition: background var(--t-fast), box-shadow var(--t-fast); }
  .direct__item:hover { background: oklch(1 0 0 / 0.05); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .direct__item :global(svg) { width: 1.3rem; height: 1.3rem; flex: none; color: var(--gold); }
  @media (min-width: 900px) { .cgrid { grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: start; } .direct { position: sticky; top: 7rem; } }
</style>
