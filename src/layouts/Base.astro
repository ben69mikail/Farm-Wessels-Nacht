---
import '@fontsource-variable/bodoni-moda';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import Intro from '../components/Intro.astro';
import { href, alternate, type Locale } from '../content/nav';
import { t } from '../content';
import { CONTACT } from '../content/contact';

interface Props { locale: Locale; pageKey: string; title: string; description: string; intro?: boolean }
const { locale, pageKey, title, description, intro = false } = Astro.props;
const copy = t(locale);
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://wild-wessels-nacht.netlify.app');
const other: Locale = locale === 'de' ? 'en' : 'de';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'Wild Wessels Safaris',
  description,
  url: canonical.href,
  email: CONTACT.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Modimolle', addressRegion: 'Limpopo', addressCountry: 'ZA', streetAddress: 'Elandspoort' },
  geo: { '@type': 'GeoCoordinates', latitude: CONTACT.geo.lat, longitude: CONTACT.geo.lng },
  ...(CONTACT.phone ? { telephone: CONTACT.phone } : {}),
};
---
<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={locale} href={new URL(href(pageKey, locale), canonical).href} />
    <link rel="alternate" hreflang={other} href={new URL(alternate(pageKey, locale), canonical).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(href(pageKey, 'de'), canonical).href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#1a1613" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wild Wessels Safaris" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={copy.htmlLang.replace('-', '_')} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{copy.ui.skip}</a>
    {intro && <Intro />}
    <Header locale={locale} pageKey={pageKey} />
    <main id="main" class="pad-bar"><slot /></main>
    <Footer locale={locale} />
    <ActionBar locale={locale} pageKey={pageKey} />
    <script>
      import '../scripts/motion';
    </script>
    <style is:global>
      .cursor {
        position: fixed; left: 0; top: 0; z-index: var(--z-cursor); pointer-events: none;
        opacity: 0; transition: opacity 0.4s; mix-blend-mode: difference;
      }
      .cursor.is-on { opacity: 1; }
      .cursor__ring {
        position: absolute; left: 0; top: 0; width: 18px; height: 18px; border-radius: 50%;
        translate: -50% -50%; background: #fff;
        transition: width 0.45s var(--ease-out), height 0.45s var(--ease-out), opacity 0.3s;
      }
      .cursor.is-link .cursor__ring { width: 56px; height: 56px; opacity: 0.85; }
      .cursor.has-label .cursor__ring { width: 96px; height: 96px; }
      .cursor__label {
        position: absolute; left: 0; top: 0; translate: -50% -50%; font-size: 0.8rem; font-weight: 500;
        color: #000; white-space: nowrap; opacity: 0; transition: opacity 0.3s;
      }
      .cursor.has-label .cursor__label { opacity: 1; }
      html.js body:has(.cursor) { cursor: none; }
      html.js body:has(.cursor) a, html.js body:has(.cursor) button { cursor: none; }
    </style>
  </body>
</html>
